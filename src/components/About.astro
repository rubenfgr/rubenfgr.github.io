---
import { contactInfo, personalInfo } from "../data/personal";
import Icon from "./Icon.astro";
---

<section class="about section" id="about">
  <div class="container">
    <h2 class="section-title reveal">Sobre mí</h2>

    <div class="about-content">
      <div class="about-text reveal">
        <h3 class="about-subtitle">Desarrollador FullStack Apasionado</h3>
        <p class="about-description">
          {personalInfo.summary}
        </p>

        <div class="about-info">
          <div class="about-info-item">
            <span class="info-label">Email:</span>
            <a href={`mailto:${contactInfo.email}`} class="info-value">
              {contactInfo.email}
            </a>
          </div>

          <div class="about-info-item">
            <span class="info-label">Ubicación:</span>
            <span class="info-value">{contactInfo.location}</span>
          </div>

          {
            contactInfo.phone && (
              <div class="about-info-item">
                <span class="info-label">Teléfono:</span>
                <a href={`tel:${contactInfo.phone}`} class="info-value">
                  {contactInfo.phone}
                </a>
              </div>
            )
          }
        </div>

        <div class="about-stats">
          {
            personalInfo.stats.map((stat) => (
              <div class="stat-item">
                <span class="stat-number">{stat.value}</span>
                <span class="stat-label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="about-features reveal">
        {
          personalInfo.features.map((feature) => (
            <div class="feature-card">
              <div class="feature-icon">
                <Icon name={feature.icon as any} width={32} height={32} />
              </div>
              <h4 class="feature-title">{feature.title}</h4>
              <p class="feature-description">{feature.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background-color: var(--color-bg-secondary);
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  @media (min-width: 1024px) {
    .about-content {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
      align-items: start;
    }
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about-subtitle {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
  }

  .about-description {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .about-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background-color: var(--color-bg-tertiary);
    border-radius: var(--radius-lg);
    margin-top: var(--space-4);
  }

  .about-info-item {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  @media (min-width: 640px) {
    .about-info-item {
      flex-wrap: nowrap;
      gap: var(--space-3);
    }
  }

  .info-label {
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .info-label {
      min-width: 100px;
    }
  }

  .info-value {
    color: var(--color-text-secondary);
    word-break: break-word;
  }

  .info-value:is(a) {
    color: var(--color-accent);
  }

  .info-value:is(a):hover {
    color: var(--color-accent-hover);
  }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (min-width: 640px) {
    .about-stats {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: var(--space-6);
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-4);
    background-color: var(--color-bg-tertiary);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  .stat-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .stat-number {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--color-accent);
    line-height: 1;
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-top: var(--space-2);
  }

  .about-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .about-features {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-card {
    padding: var(--space-6);
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent);
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background: linear-gradient(
      135deg,
      var(--color-accent) 0%,
      var(--color-accent-hover) 100%
    );
    color: white;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
  }

  .feature-title {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .feature-description {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>
