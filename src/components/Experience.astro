---
import { experience } from "../data/experience";
import { projects } from "../data/projects";
---

<section class="experience section" id="experience">
  <div class="container">
    <h2 class="section-title reveal">Experiencia Profesional</h2>
    <p class="section-subtitle reveal">
      Mi trayectoria profesional desarrollando soluciones tecnológicas
      innovadoras
    </p>

    <div class="timeline">
      {
        experience.map((exp, index) => {
          const expProjects = projects.filter((p) =>
            exp.projectIds.includes(p.id),
          );

          return (
            <div
              class="timeline-item reveal"
              style={`animation-delay: ${index * 0.1}s`}
            >
              <div class="timeline-marker" />
              <div class="timeline-content">
                <div class="timeline-header">
                  <div>
                    <h3 class="timeline-company">{exp.company}</h3>
                    {exp.position && (
                      <h4 class="timeline-position">{exp.position}</h4>
                    )}
                  </div>
                  <span class="timeline-period">{exp.period}</span>
                </div>

                {exp.description && (
                  <p class="timeline-description">{exp.description}</p>
                )}

                {exp.achievements && exp.achievements.length > 0 && (
                  <div class="timeline-achievements">
                    <h5 class="achievements-title">Logros destacados:</h5>
                    <ul class="achievements-list">
                      {exp.achievements.map((achievement) => (
                        <li>{achievement}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {expProjects.length > 0 && (
                  <div class="timeline-projects">
                    <h5 class="projects-title">Proyectos principales:</h5>
                    <div class="projects-scroll-container">
                      <div class="projects-scroll">
                        {expProjects.map((project) => (
                          <div class="project-card">
                            <div class="project-card-header">
                              <h6 class="project-card-title">
                                {project.title}
                              </h6>
                              {project.year && (
                                <span class="project-card-year">
                                  {project.year}
                                </span>
                              )}
                            </div>
                            {project.summary && (
                              <p class="project-card-description">
                                {project.summary}
                              </p>
                            )}
                            <div class="project-card-technologies">
                              {project.technologies.slice(0, 3).map((tech) => (
                                <span class="tech-tag">{tech}</span>
                              ))}
                              {project.technologies.length > 3 && (
                                <span class="tech-tag tech-more">
                                  +{project.technologies.length - 3}
                                </span>
                              )}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .experience {
    background-color: var(--color-bg-primary);
  }

  .timeline {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-8) 0;
  }

  /* Timeline line */
  .timeline::before {
    content: "";
    position: absolute;
    left: var(--space-4);
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-border);
  }

  @media (min-width: 768px) {
    .timeline::before {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-12);
    padding-left: var(--space-12);
  }

  @media (min-width: 768px) {
    .timeline-item {
      width: 50%;
      padding-left: 0;
      padding-right: var(--space-8);
    }

    .timeline-item:nth-child(even) {
      margin-left: 50%;
      padding-right: 0;
      padding-left: var(--space-8);
    }
  }

  .timeline-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--space-4);
    height: var(--space-4);
    background-color: var(--color-accent);
    border: 3px solid var(--color-bg-primary);
    border-radius: 50%;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .timeline-marker {
      left: auto;
      right: calc(var(--space-8) * -1 - 8px);
    }

    .timeline-item:nth-child(even) .timeline-marker {
      right: auto;
      left: calc(var(--space-8) * -1 - 8px);
    }
  }

  .timeline-content {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .timeline-content:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .timeline-company {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .timeline-position {
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    color: var(--color-accent);
    margin: var(--space-1) 0 0;
  }

  .timeline-period {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-accent-light);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    border-radius: var(--radius-md);
    white-space: nowrap;
  }

  [data-theme="dark"] .timeline-period {
    background-color: var(--color-accent-light);
    color: var(--color-accent-hover);
  }

  .timeline-description {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .timeline-achievements {
    margin-top: var(--space-6);
  }

  .achievements-title,
  .projects-title {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }

  .achievements-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .achievements-list li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .achievements-list li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
  }

  .timeline-projects {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .projects-scroll-container {
    position: relative;
    overflow: hidden;
    margin: 0 calc(var(--space-6) * -1);
    padding: 0 var(--space-6);
  }

  .projects-scroll {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: var(--color-accent) var(--color-bg-tertiary);
    padding-top: var(--space-2);
    padding-bottom: var(--space-3);
  }

  .projects-scroll::-webkit-scrollbar {
    height: 6px;
  }

  .projects-scroll::-webkit-scrollbar-track {
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-full);
  }

  .projects-scroll::-webkit-scrollbar-thumb {
    background: var(--color-accent);
    border-radius: var(--radius-full);
  }

  .projects-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--color-accent-hover);
  }

  .project-card {
    min-width: 280px;
    max-width: 320px;
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: all var(--transition-base);
  }

  .project-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .project-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .project-card-title {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
    flex: 1;
  }

  .project-card-year {
    background-color: var(--color-accent-light);
    color: var(--color-accent);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .project-card-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-card-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
  }

  .tech-tag {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .tech-more {
    background-color: var(--color-accent-light);
    color: var(--color-accent);
    font-weight: var(--font-semibold);
  }
</style>
