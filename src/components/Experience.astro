---
import { experience } from '../data/experience';
import { projects } from '../data/projects';
---

<section class="experience section" id="experience">
  <div class="container">
    <h2 class="section-title reveal">Experiencia Profesional</h2>
    <p class="section-subtitle reveal">
      Mi trayectoria profesional desarrollando soluciones tecnológicas innovadoras
    </p>

    <div class="timeline">
      {experience.map((exp, index) => {
        const expProjects = projects.filter(p => exp.projectIds.includes(p.id));
        
        return (
          <div class="timeline-item reveal" style={`animation-delay: ${index * 0.1}s`}>
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <div class="timeline-header">
                <div>
                  <h3 class="timeline-company">{exp.company}</h3>
                  {exp.position && (
                    <h4 class="timeline-position">{exp.position}</h4>
                  )}
                </div>
                <span class="timeline-period">{exp.period}</span>
              </div>

              {exp.description && (
                <p class="timeline-description">{exp.description}</p>
              )}

              {exp.achievements && exp.achievements.length > 0 && (
                <div class="timeline-achievements">
                  <h5 class="achievements-title">Logros destacados:</h5>
                  <ul class="achievements-list">
                    {exp.achievements.map(achievement => (
                      <li>{achievement}</li>
                    ))}
                  </ul>
                </div>
              )}

              {expProjects.length > 0 && (
                <div class="timeline-projects">
                  <h5 class="projects-title">Proyectos principales:</h5>
                  <div class="projects-grid">
                    {expProjects.slice(0, 3).map(project => (
                      <div class="project-tag">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="9 11 12 14 22 4"></polyline>
                          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                        </svg>
                        <span>{project.title}</span>
                      </div>
                    ))}
                    {expProjects.length > 3 && (
                      <span class="projects-more">
                        +{expProjects.length - 3} más
                      </span>
                    )}
                  </div>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .experience {
    background-color: var(--color-bg-primary);
  }

  .timeline {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-8) 0;
  }

  /* Timeline line */
  .timeline::before {
    content: '';
    position: absolute;
    left: var(--space-4);
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-border);
  }

  @media (min-width: 768px) {
    .timeline::before {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-12);
    padding-left: var(--space-12);
  }

  @media (min-width: 768px) {
    .timeline-item {
      width: 50%;
      padding-left: 0;
      padding-right: var(--space-8);
    }

    .timeline-item:nth-child(even) {
      margin-left: 50%;
      padding-right: 0;
      padding-left: var(--space-8);
    }
  }

  .timeline-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--space-4);
    height: var(--space-4);
    background-color: var(--color-accent);
    border: 3px solid var(--color-bg-primary);
    border-radius: 50%;
    z-index: 2;
  }

  @media (min-width: 768px) {
    .timeline-marker {
      left: auto;
      right: calc(var(--space-8) * -1 - 8px);
    }

    .timeline-item:nth-child(even) .timeline-marker {
      right: auto;
      left: calc(var(--space-8) * -1 - 8px);
    }
  }

  .timeline-content {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
  }

  .timeline-content:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .timeline-company {
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .timeline-position {
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    color: var(--color-accent);
    margin: var(--space-1) 0 0;
  }

  .timeline-period {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-accent-light);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    border-radius: var(--radius-md);
    white-space: nowrap;
  }

  [data-theme='dark'] .timeline-period {
    background-color: var(--color-accent-light);
    color: var(--color-accent-hover);
  }

  .timeline-description {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .timeline-achievements {
    margin-top: var(--space-6);
  }

  .achievements-title,
  .projects-title {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }

  .achievements-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .achievements-list li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .achievements-list li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: bold;
  }

  .timeline-projects {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .projects-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .project-tag:hover {
    background-color: var(--color-accent-light);
    color: var(--color-accent);
  }

  .project-tag svg {
    flex-shrink: 0;
  }

  .projects-more {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
  }
</style>
