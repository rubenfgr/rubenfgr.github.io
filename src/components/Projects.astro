---
import { projects } from "../data";

const featuredProjects = projects.filter((p) => p.featured);
---

<section id="projects" class="section projects">
  <div class="container">
    <h2 class="section-title reveal">Proyectos Destacados</h2>
    <p class="section-subtitle reveal">
      Una selección de los proyectos más relevantes en los que he trabajado
    </p>

    <div class="projects-carousel">
      <div class="carousel-wrapper">
        <div class="carousel-track" id="carousel-track">
          {
            featuredProjects.map((project) => (
              <div class="carousel-slide">
                <article class="project-card card">
                  {/* Imagen del proyecto */}
                  <div class="project-image-container">
                    <img
                      src="img/private-project.png"
                      alt={project.title}
                      class="project-image"
                      loading="lazy"
                    />
                  </div>

                  {/* Contenido del proyecto */}
                  <div class="project-body">
                    <div class="project-header">
                      <h3 class="project-title">{project.title}</h3>
                      {project.year && (
                        <span class="project-year">{project.year}</span>
                      )}
                    </div>

                    {project.company && (
                      <p class="project-company">{project.company}</p>
                    )}

                    <p class="project-description">{project.summary}</p>

                    <div class="project-technologies">
                      {project.technologies.slice(0, 4).map((tech) => (
                        <span class="tech-badge">{tech}</span>
                      ))}
                      {project.technologies.length > 4 && (
                        <span class="tech-badge tech-more">
                          +{project.technologies.length - 4}
                        </span>
                      )}
                    </div>

                    <div class="project-actions">
                      <a
                        href={`/projects/${project.slug}`}
                        class="btn-secondary btn-sm"
                      >
                        Ver detalles
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 16 16"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M6 12L10 8L6 4"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </a>
                    </div>
                  </div>
                </article>
              </div>
            ))
          }
        </div>
      </div>

      {/* Controles del carousel */}
      {
        featuredProjects.length > 1 && (
          <div class="carousel-controls">
            <button
              id="carousel-prev"
              class="carousel-btn"
              aria-label="Proyecto anterior"
            >
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M15 18L9 12L15 6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>

            <div class="carousel-dots">
              {featuredProjects.map((_, index) => (
                <button
                  class={`carousel-dot ${index === 0 ? "active" : ""}`}
                  data-index={index}
                  aria-label={`Ir al proyecto ${index + 1}`}
                />
              ))}
            </div>

            <button
              id="carousel-next"
              class="carousel-btn"
              aria-label="Proyecto siguiente"
            >
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M9 18L15 12L9 6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .projects {
    background-color: var(--color-bg-secondary);
  }

  .projects-carousel {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-4) 0;
  }

  .carousel-wrapper {
    overflow: hidden;
    border-radius: var(--radius-2xl);
  }

  .carousel-track {
    display: flex;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .carousel-slide {
    min-width: 100%;
    width: 100%;
    flex-shrink: 0;
    padding: 0 var(--space-3);
    box-sizing: border-box;
  }

  /* Project Card */
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }

  .project-image-container {
    width: 100%;
    max-height: 500px;
    height: 500px;
    overflow: hidden;
    background: linear-gradient(
      135deg,
      var(--color-accent) 0%,
      var(--color-accent-hover) 100%
    );
    flex-shrink: 0;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .project-card:hover .project-image {
    transform: scale(1.05);
  }

  .project-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .project-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
    margin: 0;
    flex: 1;
  }

  .project-year {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .project-company {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    margin: 0;
  }

  .project-description {
    color: var(--color-text-secondary);
    line-height: 1.6;
    font-size: var(--text-base);
    margin: 0;
    flex: 1;
  }

  .project-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tech-badge {
    background-color: var(--color-accent-alpha);
    color: var(--color-accent);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .tech-more {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
  }

  .project-actions {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  /* Carousel Controls */
  .carousel-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .carousel-btn {
    background-color: var(--color-bg-primary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-base);
    flex-shrink: 0;
  }

  .carousel-btn:hover {
    background-color: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
    transform: scale(1.1);
  }

  .carousel-btn:active {
    transform: scale(0.95);
  }

  .carousel-dots {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--color-border);
    border: none;
    cursor: pointer;
    transition: all var(--transition-base);
    padding: 0;
  }

  .carousel-dot:hover {
    background-color: var(--color-text-secondary);
  }

  .carousel-dot.active {
    background-color: var(--color-accent);
    width: 24px;
  }

  @media (min-width: 768px) {
    .carousel-slide {
      padding: 0 var(--space-6);
    }

    .project-image-container {
      height: 500px;
    }

    .project-title {
      font-size: var(--text-2xl);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const track = document.getElementById("carousel-track");
    const prevBtn = document.getElementById("carousel-prev");
    const nextBtn = document.getElementById("carousel-next");
    const dots = document.querySelectorAll(".carousel-dot");
    const slides = document.querySelectorAll(".carousel-slide");

    if (!track || !slides.length) return;

    let currentIndex = 0;
    const totalSlides = slides.length;

    function updateCarousel() {
      if (!track) return;

      // Mover el track
      const offset = currentIndex * -100;
      track.style.transform = `translateX(${offset}%)`;

      // Actualizar dots
      dots.forEach((dot, index) => {
        dot.classList.toggle("active", index === currentIndex);
      });
    }

    function goToSlide(index: number) {
      currentIndex = index;
      updateCarousel();
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % totalSlides;
      updateCarousel();
    }

    function prevSlide() {
      currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      updateCarousel();
    }

    // Event listeners para botones
    prevBtn?.addEventListener("click", prevSlide);
    nextBtn?.addEventListener("click", nextSlide);

    // Event listeners para dots
    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => goToSlide(index));
    });

    // Navegación con teclado
    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") prevSlide();
      else if (e.key === "ArrowRight") nextSlide();
    });

    // Soporte táctil/swipe
    let touchStartX = 0;
    let touchEndX = 0;

    track.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true },
    );

    track.addEventListener(
      "touchend",
      (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        const threshold = 50;

        if (Math.abs(diff) > threshold) {
          if (diff > 0) nextSlide();
          else prevSlide();
        }
      },
      { passive: true },
    );

    // Auto-play (5 segundos)
    let autoplayInterval = setInterval(nextSlide, 5000);

    // Pausar en hover
    track.addEventListener("mouseenter", () => clearInterval(autoplayInterval));
    track.addEventListener("mouseleave", () => {
      autoplayInterval = setInterval(nextSlide, 5000);
    });

    // Inicializar
    updateCarousel();
  });
</script>
