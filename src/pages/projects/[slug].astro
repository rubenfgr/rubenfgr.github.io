  .tech-card svg {
    flex-shrink: 0;
  }

  .project-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
