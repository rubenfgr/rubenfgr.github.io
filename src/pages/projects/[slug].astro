</style>

<script>
  // Funcionalidad del carrusel de galería
  function initGalleryCarousel() {
    const prevBtn = document.getElementById(
      "gallery-prev",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "gallery-next",
    ) as HTMLButtonElement | null;
    const galleryScroll = document.querySelector(
      ".gallery-scroll",
    ) as HTMLElement | null;

    if (!prevBtn || !nextBtn || !galleryScroll) return;

    const scrollAmount = 220; // Ancho de item (200px) + gap (20px)

    prevBtn.addEventListener("click", () => {
      galleryScroll.scrollBy({ left: -scrollAmount, behavior: "smooth" });
    });

    nextBtn.addEventListener("click", () => {
      galleryScroll.scrollBy({ left: scrollAmount, behavior: "smooth" });
    });

    // Ocultar botones en los extremos
    function updateButtons() {
      if (!prevBtn || !nextBtn || !galleryScroll) return;

      const { scrollLeft, scrollWidth, clientWidth } = galleryScroll;
      prevBtn.style.opacity = scrollLeft <= 0 ? "0.5" : "1";
      prevBtn.style.pointerEvents = scrollLeft <= 0 ? "none" : "auto";
      nextBtn.style.opacity =
        scrollLeft + clientWidth >= scrollWidth - 1 ? "0.5" : "1";
      nextBtn.style.pointerEvents =
        scrollLeft + clientWidth >= scrollWidth - 1 ? "none" : "auto";
    }

    galleryScroll.addEventListener("scroll", updateButtons);
    updateButtons();
  }

  // Funcionalidad del modal de imagen
  function initImageModal() {
    const modal = document.getElementById("imageModal");
    const modalImage = document.getElementById(
      "modalImage",
    ) as HTMLImageElement | null;
    const modalBackdrop = document.getElementById("modalBackdrop");
    const modalClose = document.getElementById("modalClose");
    const modalPrev = document.getElementById("modalPrev");
    const modalNext = document.getElementById("modalNext");
    const modalCounter = document.getElementById("modalCounter");
    const clickableImages = document.querySelectorAll<HTMLImageElement>(
      ".featured-image, .gallery-image",
    );

    if (!modal || !modalImage) return;

    let currentImageIndex = 0;
    const allImages: { src: string; alt: string }[] = [];

    // Recopilar todas las imágenes disponibles
    clickableImages.forEach((image) => {
      const src = image.getAttribute("src");
      const alt = image.getAttribute("alt");
      if (src) {
        allImages.push({ src, alt: alt || "Imagen del proyecto" });
      }
    });

    // Actualizar la imagen mostrada en el modal
    function updateModalImage() {
      if (allImages.length === 0 || !modalImage) return;

      const currentImage = allImages[currentImageIndex];
      modalImage.setAttribute("src", currentImage.src);
      modalImage.setAttribute("alt", currentImage.alt);

      // Actualizar contador
      if (modalCounter) {
        modalCounter.textContent = `${currentImageIndex + 1} / ${allImages.length}`;
      }

      // Ocultar/mostrar botones de navegación
      if (modalPrev) {
        if (currentImageIndex === 0) {
          modalPrev.classList.add("hidden");
        } else {
          modalPrev.classList.remove("hidden");
        }
      }

      if (modalNext) {
        if (currentImageIndex === allImages.length - 1) {
          modalNext.classList.add("hidden");
        } else {
          modalNext.classList.remove("hidden");
        }
      }

      // Ocultar contador si solo hay una imagen
      if (modalCounter && allImages.length <= 1) {
        modalCounter.style.display = "none";
      } else if (modalCounter) {
        modalCounter.style.display = "block";
      }
    }

    // Abrir modal al hacer clic en cualquier imagen
    clickableImages.forEach((image, index) => {
      image.addEventListener("click", () => {
        currentImageIndex = index;
        updateModalImage();
        modal.classList.add("active");
        document.body.style.overflow = "hidden";
      });
    });

    // Navegar a la imagen anterior
    if (modalPrev) {
      modalPrev.addEventListener("click", () => {
        if (currentImageIndex > 0) {
          currentImageIndex--;
          updateModalImage();
        }
      });
    }

    // Navegar a la siguiente imagen
    if (modalNext) {
      modalNext.addEventListener("click", () => {
        if (currentImageIndex < allImages.length - 1) {
          currentImageIndex++;
          updateModalImage();
        }
      });
    }

    // Cerrar modal
    function closeModal() {
      if (modal) {
        modal.classList.remove("active");
        document.body.style.overflow = "";
      }
    }

    if (modalBackdrop) {
      modalBackdrop.addEventListener("click", closeModal);
    }

    if (modalClose) {
      modalClose.addEventListener("click", closeModal);
    }

    // Navegación con teclado
    document.addEventListener("keydown", (e) => {
      if (modal && modal.classList.contains("active")) {
        if (e.key === "Escape") {
          closeModal();
        } else if (e.key === "ArrowLeft" && currentImageIndex > 0) {
          currentImageIndex--;
          updateModalImage();
        } else if (
          e.key === "ArrowRight" &&
          currentImageIndex < allImages.length - 1
        ) {
          currentImageIndex++;
          updateModalImage();
        }
      }
    });
  }

  // Inicializar cuando el DOM esté listo
  document.addEventListener("DOMContentLoaded", () => {
    initGalleryCarousel();
    initImageModal();
  });
</script>
