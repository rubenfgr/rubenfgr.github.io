---
import { projects } from "../../data/projects";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Determinar la imagen principal
const getMainImage = () => {
  // Si tiene imágenes en project.images, usar la primera
  if (project.images && project.images.length > 0) {
    return project.images[0];
  }
  // Si es proyecto personal, usar imagen personal
  if (project.company === "Personal") {
    return "/img/personal-project.png";
  }
  // Por defecto, usar imagen privada
  return "/img/private-project.png";
};

const mainImage = getMainImage();
const additionalImages =
  project.images && project.images.length > 1 ? project.images.slice(1) : [];
---

<Layout
  title={`${project.title} - Rubén Rosales`}
  description={project.summary}
>
  <div class="project-detail">
    <div class="project-hero">
      <div class="container">
        <a href="/#projects" class="back-link">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Volver a proyectos
        </a>

        <div class="hero-content">
          <div class="project-badges">
            <span class="type-badge">
              {project.type === "web" && "🌐 Web"}
              {project.type === "mobile" && "📱 Mobile"}
              {project.type === "iot" && "🔌 IoT"}
              {project.type === "desktop" && "💻 Desktop"}
              {project.type === "api" && "⚡ API"}
              {project.type === "infrastructure" && "🏗️ Infraestructura"}
            </span>
            {
              project.status && (
                <span class={`status-badge status-${project.status}`}>
                  {project.status === "maintained" && "🔄 En mantenimiento"}
                  {project.status === "completed" && "✅ Completado"}
                  {project.status === "in-progress" && "🚧 En progreso"}
                </span>
              )
            }
          </div>

          <h1 class="project-title">{project.title}</h1>

          {
            project.company && (
              <p class="project-company">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                  <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
                {project.company}
              </p>
            )
          }

          {
            project.year && (
              <p class="project-year">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                  <line x1="16" y1="2" x2="16" y2="6" />
                  <line x1="8" y1="2" x2="8" y2="6" />
                  <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
                {project.year}
              </p>
            )
          }
        </div>
      </div>
    </div>

    <!-- Imagen principal destacada -->
    <div class="project-featured-image">
      <div class="container">
        <div class="main-image-container">
          <img
            src={mainImage}
            alt={project.title}
            class="featured-image"
            id="mainImage"
          />
        </div>
      </div>
    </div>

    <!-- Carrusel de imágenes adicionales -->
    {
      additionalImages.length > 0 && (
        <div class="project-gallery">
          <div class="container">
            <h3 class="gallery-title">Más capturas</h3>
            <div class="gallery-carousel">
              <button
                class="gallery-btn gallery-prev"
                id="gallery-prev"
                aria-label="Anterior"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="15 18 9 12 15 6" />
                </svg>
              </button>

              <div class="gallery-scroll">
                {additionalImages.map((image, index) => (
                  <div class="gallery-item">
                    <img
                      src={image}
                      alt={`${project.title} - Captura ${index + 2}`}
                      class="gallery-image"
                      data-full-image={image}
                    />
                  </div>
                ))}
              </div>

              <button
                class="gallery-btn gallery-next"
                id="gallery-next"
                aria-label="Siguiente"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="9 18 15 12 9 6" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      )
    }

    <!-- Modal para imagen ampliada -->
    <div class="image-modal" id="imageModal">
      <div class="modal-backdrop" id="modalBackdrop"></div>
      <div class="modal-content">
        <button class="modal-close" id="modalClose" aria-label="Cerrar">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <button
          class="modal-nav modal-prev"
          id="modalPrev"
          aria-label="Imagen anterior"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <img src="" alt="" class="modal-image" id="modalImage" />

        <button
          class="modal-nav modal-next"
          id="modalNext"
          aria-label="Siguiente imagen"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <div class="modal-counter" id="modalCounter">1 / 10</div>
      </div>
    </div>

    <div class="project-content">
      <div class="container">
        <div class="content-grid">
          <div class="main-content">
            <section class="content-section">
              <h2 class="section-title">Descripción del Proyecto</h2>
              <p class="description">
                {
                  project.longDescription ||
                    project.summary ||
                    project.description
                }
              </p>
            </section>

            <section class="content-section">
              <h2 class="section-title">Tecnologías Utilizadas</h2>
              <div class="technologies-grid">
                {
                  project.technologies.map((tech) => (
                    <div class="tech-card">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="16 18 22 12 16 6" />
                        <polyline points="8 6 2 12 8 18" />
                      </svg>
                      <span>{tech}</span>
                    </div>
                  ))
                }
              </div>
            </section>
          </div>

          <aside class="sidebar">
            <div class="info-card">
              <h3 class="info-title">Información del Proyecto</h3>

              <div class="info-items">
                {
                  project.type && (
                    <div class="info-item">
                      <span class="info-label">Tipo:</span>
                      <span class="info-value">{project.type}</span>
                    </div>
                  )
                }

                {
                  project.year && (
                    <div class="info-item">
                      <span class="info-label">Año:</span>
                      <span class="info-value">{project.year}</span>
                    </div>
                  )
                }

                {
                  project.company && (
                    <div class="info-item">
                      <span class="info-label">Cliente:</span>
                      <span class="info-value">{project.company}</span>
                    </div>
                  )
                }

                {
                  project.status && (
                    <div class="info-item">
                      <span class="info-label">Estado:</span>
                      <span class="info-value">
                        {project.status === "maintained" && "En mantenimiento"}
                        {project.status === "completed" && "Completado"}
                        {project.status === "in-progress" && "En progreso"}
                      </span>
                    </div>
                  )
                }
              </div>

              {
                (project.demoUrl || project.repoUrl) && (
                  <div class="project-links">
                    {project.demoUrl && (
                      <a
                        href={project.demoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-primary"
                      >
                        Ver Demo
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                          <polyline points="15 3 21 3 21 9" />
                          <line x1="10" y1="14" x2="21" y2="3" />
                        </svg>
                      </a>
                    )}
                    {project.repoUrl && (
                      <a
                        href={project.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary"
                      >
                        Ver Código
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                        </svg>
                      </a>
                    )}
                  </div>
                )
              }
            </div>

            <div class="cta-card">
              <h3 class="cta-title">¿Interesado en un proyecto similar?</h3>
              <p class="cta-text">
                Puedo ayudarte a desarrollar una solución personalizada para tu
                negocio.
              </p>
              <a href="/#contact" class="btn btn-primary">
                Contactar
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .project-detail {
    padding-top: var(--header-height);
  }

  .project-hero {
    background: linear-gradient(
      135deg,
      var(--color-bg-secondary) 0%,
      var(--color-bg-tertiary) 100%
    );
    padding: var(--space-12) 0 var(--space-16);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    margin-bottom: var(--space-8);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .hero-content {
    max-width: 800px;
  }

  .project-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .type-badge,
  .status-badge {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    border-radius: var(--radius-md);
  }

  .type-badge {
    background-color: var(--color-accent-light);
    color: var(--color-accent);
  }

  [data-theme="dark"] .type-badge {
    background-color: var(--color-accent-light);
    color: var(--color-accent-hover);
  }

  .status-maintained {
    background-color: #dbeafe;
    color: #1e40af;
  }

  .status-completed {
    background-color: #d1fae5;
    color: #065f46;
  }

  .status-in-progress {
    background-color: #fef3c7;
    color: #92400e;
  }

  [data-theme="dark"] .status-maintained {
    background-color: #1e3a8a;
    color: #93c5fd;
  }

  [data-theme="dark"] .status-completed {
    background-color: #064e3b;
    color: #6ee7b7;
  }

  [data-theme="dark"] .status-in-progress {
    background-color: #78350f;
    color: #fcd34d;
  }

  .project-title {
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  @media (min-width: 768px) {
    .project-title {
      font-size: var(--text-5xl);
    }
  }

  .project-company,
  .project-year {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .project-company svg,
  .project-year svg {
    color: var(--color-accent);
  }

  .project-featured-image {
    background-color: var(--color-bg-secondary);
    padding: var(--space-8) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .main-image-container {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .featured-image {
    max-width: 800px;
    width: 100%;
    height: auto;
    max-height: 600px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    cursor: pointer;
    transition: transform var(--transition-base);
  }

  .featured-image:hover {
    transform: scale(1.02);
  }

  /* Galería de imágenes adicionales */
  .project-gallery {
    background-color: var(--color-bg-primary);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .gallery-title {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .gallery-carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .gallery-scroll {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: var(--space-2) 0;
  }

  .gallery-scroll::-webkit-scrollbar {
    display: none;
  }

  .gallery-item {
    flex-shrink: 0;
    width: 200px;
    height: 150px;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: transform var(--transition-base);
  }

  .gallery-item:hover {
    transform: scale(1.05);
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast);
  }

  .gallery-item:hover .gallery-image {
    border-color: var(--color-accent);
  }

  .gallery-btn {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .gallery-btn:hover {
    background-color: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  .gallery-btn:active {
    transform: scale(0.95);
  }

  /* Modal para imagen ampliada */
  .image-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .image-modal.active {
    display: flex;
  }

  .modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    cursor: pointer;
  }

  .modal-content {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    z-index: 10000;
  }

  .modal-image {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--radius-lg);
  }

  .modal-close {
    position: absolute;
    top: -50px;
    right: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .modal-close:hover {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .modal-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.15);
    color: white;
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
    z-index: 10001;
  }

  .modal-nav:hover {
    background-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-50%) scale(1.1);
  }

  .modal-nav:active {
    transform: translateY(-50%) scale(0.95);
  }

  .modal-nav.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .modal-prev {
    left: -80px;
  }

  .modal-next {
    right: -80px;
  }

  .modal-counter {
    position: absolute;
    bottom: -50px;
    left: 50%;
    transform: translateX(-50%);
    padding: var(--space-2) var(--space-4);
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .modal-nav {
      width: 48px;
      height: 48px;
    }

    .modal-prev {
      left: 10px;
    }

    .modal-next {
      right: 10px;
    }

    .modal-close {
      top: 10px;
      right: 10px;
    }

    .modal-counter {
      bottom: 20px;
    }
  }

  @media (max-width: 768px) {
    .gallery-carousel {
      gap: var(--space-2);
    }

    .gallery-btn {
      display: none;
    }

    .gallery-item {
      width: 150px;
      height: 112px;
    }
  }

  .project-content {
    padding: var(--space-16) 0;
    background-color: var(--color-bg-primary);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  @media (min-width: 1024px) {
    .content-grid {
      grid-template-columns: 1fr 350px;
      gap: var(--space-16);
    }
  }

  .main-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .content-section {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }

  .description {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .technologies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-3);
  }

  .tech-card {
    display: flex;
    align-items: center;
    gap: var(--space-2);
